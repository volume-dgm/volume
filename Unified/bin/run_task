#!/bin/bash

taskname=""
num_proc=0
dim_count=3
build_mesh=0
po=1

while [ "$1" != "" ]; do
  case $1 in  
    -n | --name )        shift
                         taskname=$1
                         ;;
    -np | --num_procs )  shift
                         np=$1
                         ;;
    -d | --dims )        shift
                         dim_count=$1
                         ;;
    -po | --poly_order ) shift
                         po=$1
                         ;;
    -bm | --build_mesh ) build_mesh=1
  esac
  shift
done

if [[ $build_mesh -eq 1 ]]; then
      ./meshbuilder $dim_count $taskname
      echo 
fi

if [[ ! $np -eq 0 ]]; then 
  export OMP_NUM_THREADS=$np 
  export OMP_THREAD_LIMIT=$np
fi  

./task $dim_count $po $taskname
