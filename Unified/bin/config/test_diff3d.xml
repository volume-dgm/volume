<?xml version="1.0" encoding="UTF-8" ?>
<Settings dimsCount="3">
  <MeshBuilder>
    <SalomeFile fileName="salome/test_diff3d" />
    <OutFile fileName = "meshes/test_diff3d" />
  </MeshBuilder>

  <LambdaParser>
    <AssignGlobal name="it" value="10.0"/>
    <AssignGlobal name="ib" value="0.0"/>
    <AssignGlobal name="Gmax" value="1.87e+9"/>
    <AssignGlobal name="Gmin" value="lambda global . / (get global 'Gmax') 8 "/>
    <AssignGlobal name="iniSpeed" value="2,0"/>
  </LambdaParser>

  <Mesh fileName="meshes/test_diff3d" unfoldIterationsCount="0" minGridHeight="2e-4" moveMassCenter="false" collisionWidth="0.00001">
    <MediumParams>
      <PerSubmesh fileName="meshes/test_diff3d.params"> 
      <Submesh index="0" E="5e+9" G="lambda global x y z . (+ (get global 'Gmin') (/ (* (- z (get global 'ib')) (- (get global 'Gmax') (get global 'Gmin'))) (- (get global 'it') (get global 'ib'))))" rho="920" fixed="false" internalContactType="0"/>
        <Submesh index="1" E="5e+9" G="1.87e+9" rho="500" fixed="false" internalContactType="1">
        </Submesh>
      </PerSubmesh>
    </MediumParams>

    <Boundaries>
      <Free interactionType="0" dynamicContactInteractionType = "2" />
      <Free interactionType="1" dynamicContactInteractionType = "2" />
    </Boundaries>

    <Contacts>
      <Glue interactionType = "0" />
      <Glue interactionType = "1" />
      <Friction interactionType="2" frictionCoeff="0.1"/>
    </Contacts>
  </Mesh>

  <Snapshot>
    <Period time="1e-3" />
    <Data fileName="out/test_diff3d/test_diff[<domain>]<step>.vti" writeVelocity="True" writeTension="True">
      <Box boxPoint1="-10.1 0.0 0.0" boxPoint2="10.1 10.0 10.0" />
      <Resolution resolution="200 100 100" />
    </Data>
    <Mesh />
    <CellInfos />
  </Snapshot>

  <Schedule domainsCount="1" />

  <Task destinationTime = "0.2">
    <IniState>
      <BoxState boxPoint1 = "-10.1 0.0 0.0" boxPoint2 = "0.0 10.0 10.0" velocity = "lambda global x y z . (get global 'Vector3') (get global 'iniSpeed') 0 0"/>
      <BoxState boxPoint1 = "0.0 0.0 0.0" boxPoint2 = "10.1 10.0 10.0" velocity = "lambda global x y z . (get global 'Vector3') (* -1 (get global 'iniSpeed')) 0 0"/>
    </IniState>
  </Task>

  <Solver polynomialsOrder="1" precision="double" integrator="RK4"
          tolerance="1e-1" maxScale="1e-1" maxTimeStep="3.35e-5" hierarchyLevelsCount="1" 
          allowMovement="true" allowPlasticity="true" allowDestruction="true"
          allowDiscreteDestruction="true" 
          allowContinuousDestruction="true" 
          tensionErrorMult="1e-10" velocityErrorMult="1e-2" positionErrorMult="1e-4"
          velocityDimensionlessMult="1e+0" tensionDimensionlessMult="1e+0"/>
</Settings>
