<?xml version="1.0" encoding="UTF-8" ?>
<Settings dimsCount="2">
  <MeshBuilder>
    <SalomeFile fileName="salome/test_timed" />
    <OutFile fileName = "meshes/test_timed" />
  </MeshBuilder>

  <Mesh fileName="meshes/test_timed" unfoldIterationsCount="0" minGridHeight="2e-4" moveMassCenter="false" collisionWidth="0.0001">
    <MediumParams>
      <PerSubmesh fileName="meshes/test_timed.params"> 
        <Submesh index="0" E="5e+9" G="1.87e+9" rho="920" fixed="false" internalContactType="0">
          <ModifyParams paramName="mju" dependencyType="linear" axisName="x" p2="1.87e+9" p1="4.68e+8" p3="-5.0" p4="5.0"/>
        </Submesh>
      </PerSubmesh>
    </MediumParams>

    <Boundaries>
      <Free interactionType="0" >
        <ExternalForce>
          <TimedImpulseFunctor value="0.0 1000.0 0.0" timeBegin="0.05" timeEnd="0.1"/>
        </ExternalForce>
      </Free>
      <Absorb interactionType="1" />
    </Boundaries>

    <Contacts>
      <Glue interactionType = "0" />
    </Contacts>
  </Mesh>

  <Snapshot>
    <Period time="1e-3" />
    <Data fileName="out/test_timed/test_timed[<domain>]<step>.vti" writeVelocity="True" writeTension="True">
      <Box boxPoint1="-5.0 -5.0" boxPoint2="5.0 5.0" />
      <Resolution resolution="200 200" />
    </Data>
    <Mesh fileName="out/test_timed/mesh[<domain>]<step>.vtk"/>
    <CellInfos fileName="out/test_timed/cell_info[<domain>]<step>.vtk"/>
  </Snapshot>

  <Schedule domainsCount="1" />

  <Task destinationTime = "0.2">
    <!--
    <IniState>
      <BoxState boxPoint1 = "-10.1 -5.0" boxPoint2 = "0.0 5.0" velocity = "1.0 0.0"/>
      <BoxState boxPoint1 = "0.0 -5.0" boxPoint2 = "10.1 5.0" velocity = "-1.0 0.0"/>
      </IniState>
    -->
  </Task>

  <Solver polynomialsOrder="1" precision="double" integrator="RK4"
          tolerance="1e-1" maxScale="1e-2" maxTimeStep="6.7e-5" hierarchyLevelsCount="1" 
          allowMovement="true" allowPlasticity="true" allowDestruction="true"
          allowDiscreteDestruction="true" 
          allowContinuousDestruction="true" 
          tensionErrorMult="1e-10" velocityErrorMult="1e-2" positionErrorMult="1e-4"
          velocityDimensionlessMult="1e+0" tensionDimensionlessMult="1e+0"/>
</Settings>
