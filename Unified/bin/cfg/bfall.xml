<?xml version="1.0" encoding="UTF-8" ?>
<Settings dimsCount = "3">

  <MeshBuilder>
    <SalomeFile fileName= "salome/bfall" />
    <OutFile fileName= "meshes/bfall" />
  </MeshBuilder>

  <Mesh fileName="meshes/bfall" unfoldIterationsCount="0" minGridHeight="2e-4" moveMassCenter="false" collisionWidth= "0.0"> 
    <MediumParams>
      <PerSubmesh fileName = "meshes/bfall.params">
        <Submesh index="1" E="5e+9" G="1.87e+9" rho= "920" k= "2.5e+6" alpha="0.1" brittle="false" 
        internalContactType= "1" maxPlasticDeform="0.012" powderShearMult="0.1" fixed = "false"/> 
        <Submesh index="0" sSpeed="3100" pSpeed="5700" rho= "10000" fixed = "false" internalContactType= "0"/> 
      </PerSubmesh> 
    </MediumParams>

    <Boundaries>
      <Absorb interactionType= "0">
      </Absorb>

      <Free interactionType="1" dynamicContactInteractionType="2">
      </Free>

      <Free interactionType= "2" dynamicContactInteractionType="2">
      </Free>

    </Boundaries>

    <Contacts>
      <Glue interactionType= "0" dynamicBoundaryInteractionType= "2" maxLongitudinalStress="1.2e+6"  maxShearStress="4.8e+6"/>
      <Glue interactionType= "1" dynamicBoundaryInteractionType= "0"/>
      <Glide interactionType= "2" dynamicBoundaryInteractionType= "2"/>
    </Contacts>
  </Mesh>

  <Snapshot>
    <Period time="2e-2" />
    <Data fileName = "out/bfall/data_<step>.vti"  writeVelocity="true" writeTension="false">
      <Box boxPoint1 = "-50.0 -1.0 -50.0" boxPoint2 = "50.0 25.0 50.0" />
      <Resolution resolution="100 26 100" />
    </Data>
    <Mesh fileName="out/bfall/mesh_<step>.vtk" />
  </Snapshot>

  <Schedule domainsCount="1"/>

  <Task destinationTime = "1.5">
    <!--
    <IniState>
      <BoxState boxPoint1 = "-18.0 -1.0 -9.0" boxPoint2 = "12.0 11.0 9.0" velocity = "2.0 -4.0 0.0"/>
    </IniState>
    -->
    <SourceTerms>
      <ConstantAcceleration acceleration="0 0 -0.00981"/> 
    </SourceTerms>  
  </Task>

  <Solver polynomialsOrder= "1" precision="double" integrator="RK4" updateCollisionInfoPeriod="10"
        tolerance="1e-1" maxScale="1e-2" maxTimeStep="1.0e-4" hierarchyLevelsCount="1"
        allowMovement="true" allowPlasticity="true" allowDestruction="true"
        allowContinuousDestruction="true" allowDiscreteDestruction="true"
        tensionErrorMult="1e-10" velocityErrorMult="1e-2" positionErrorMult="1e-4"
        velocityDimensionlessMult="1e+0" tensionDimensionlessMult="1e+0">
        <Erosion cellAspectRatio="6" minHeightRatio="0.0" maxPlasticDeformation="1.004" rhoReduction="6.0"/>
  </Solver>

</Settings>
