<?xml version="1.0" encoding="UTF-8" ?>
<Settings dimsCount = "3">

  <MeshBuilder>
    <SalomeFile fileName= "salome/sub" />
    <OutFile fileName= "meshes/sub" />
  </MeshBuilder>

  <Mesh fileName="meshes/sub" unfoldIterationsCount="0" minGridHeight="2e-4" moveMassCenter="false" collisionWidth= "0.0"> 
    <MediumParams>
      <PerSubmesh fileName = "meshes/sub.params">
        <Submesh index="0" E="5e+9" G="1.87e+9" rho= "920" k= "2.5e+6" alpha="0.1" brittle="false" 
        internalContactType= "0" maxPlasticDeform="0.012" powderShearMult="0.1" fixed = "false"/> 
        <Submesh index="1" sSpeed="3100" pSpeed="5700" rho= "10000" fixed = "false" internalContactType= "1"/> 
      </PerSubmesh> 
    </MediumParams>

    <Boundaries>
      <Absorb interactionType= "0">
      </Absorb>

      <Free interactionType="1" dynamicContactInteractionType="2">
      </Free>

      <Free interactionType= "2" dynamicContactInteractionType="2">
      </Free>

    </Boundaries>

    <Contacts>
      <Glue interactionType= "0" dynamicBoundaryInteractionType= "2" maxLongitudinalStress="1.2e+6"  maxShearStress="4.8e+6"/>
      <Glue interactionType= "1" dynamicBoundaryInteractionType= "0"/>
      <Glide interactionType= "2" dynamicBoundaryInteractionType= "2"/>
    </Contacts>
  </Mesh>

  <Snapshot>
    <Period time="1e-2" />
    <Data fileName = "out/sub/data_<step>.vti"  writeVelocity="true" writeTension="true">
      <Box boxPoint1 = "-30.0 0.0 -30.0" boxPoint2 = "150.0 17.0 30.0" />
      <Resolution resolution="360 34 120" />
      </Data>
    <Mesh fileName="out/sub/mesh_<step>.vtk" />
    <Boundaries fileName="out/sub/boundaries_<step>.vtk"/>
  </Snapshot>

  <Schedule domainsCount="1"/>

  <Task destinationTime = "4.0">
    <IniState>
      <BoxState boxPoint1 = "-1.0 0.0 -9.0" boxPoint2 = "120.0 15.95 9.0" velocity = "0.0 2.0 0.0"/>
    </IniState>
  </Task>

  <Solver polynomialsOrder= "1" precision="double" integrator="RK4" updateCollisionInfoPeriod="10"
        tolerance="1e-1" maxScale="1e-2" maxTimeStep="4.73e-4" hierarchyLevelsCount="1"
        allowMovement="true" allowPlasticity="true" allowDestruction="true"
        allowContinuousDestruction="true" allowDiscreteDestruction="true"
        tensionErrorMult="1e-10" velocityErrorMult="1e-2" positionErrorMult="1e-4"
        velocityDimensionlessMult="1e+0" tensionDimensionlessMult="1e+0">
        <Erosion cellAspectRatio="6" minHeightRatio="0.0" maxPlasticDeformation="1.004" rhoReduction="6.0"/>
  </Solver>

</Settings>
