<?xml version="1.0" encoding="UTF-8" ?>
<Settings dimsCount = "3">

  <MeshBuilder>
    <SalomeFile fileName= "salome/lenin" />
    <OutFile fileName= "meshes/lenin" />
  </MeshBuilder>

<Mesh fileName="meshes/lenin" unfoldIterationsCount="0" minGridHeight="2e-4" moveMassCenter="false" collisionWidth= "0.00001"> 
    <MediumParams>
      <PerSubmesh fileName = "meshes/lenin.params"> 
        <Submesh index="0" E="5e+9" G="1.87e+9" rho= "920" 
          internalContactType= "0" fixed = "false"/> 
        <Submesh index="1" sSpeed="3100" pSpeed="5700" rho= "7500" fixed = "false" internalContactType= "1"/> 
      </PerSubmesh> 
    </MediumParams>

    <Boundaries>
      <Absorb interactionType= "0">
      </Absorb>

      <Free interactionType="1" dynamicContactInteractionType="2">
      </Free>

      <Free interactionType= "2" dynamicContactInteractionType="2">
        </Free>

        <Free interactionType= "3" >
          <!--
        <ExternalForce>
          <ConstFunctor value="-4e10 0.0 0.0"/>
          </ExternalForce>
          -->
            </Free>
            
      <Free interactionType= "4">
        </Free>

      </Boundaries>

    <Contacts>
      <Glue interactionType= "0" dynamicBoundaryInteractionType= "4" maxLongitudinalStress="1.2e+6"/>
      <Glue interactionType= "1" />
      <Glide interactionType= "2" dynamicBoundaryInteractionType= "1"/>
    </Contacts>
  </Mesh>

  <Snapshot>
    <Period time="1e-2" />
    <Data fileName = "out/lenin1/data_<step>.vti"  writeVelocity="true" writeTension="true">
      <Box boxPoint1 = "-150 -50.0 -8.0" boxPoint2 = "80.0 50.0 7.0" />
      <Resolution resolution="460 200 30" />
      </Data>
    <Mesh fileName="out/lenin1/mesh_<step>.vtk" />
    <Boundaries fileName="out/lenin1/boundaries_<step>.vtk"/>
  </Snapshot>

  <Schedule domainsCount="1"/>

  <Task destinationTime = "10.0">
    <IniState>
      <BoxState boxPoint1 = "00.0 -15.0 -8.0" boxPoint2 = "81.0 15.0 7.0" velocity = "-12.0 0.0 0.0"/>
      </IniState>

      <!--
    <SourceTerms>
      <ConstantAcceleration acceleration="0 0.0 -0.981"/> 
        </SourceTerms>  
      -->
  </Task>

  <Solver polynomialsOrder= "1" precision="double" integrator="RK4" updateCollisionInfoPeriod="10"
        tolerance="1e-1" maxScale="1e-2" maxTimeStep="5.35e-5" hierarchyLevelsCount="1"
        allowMovement="true" allowPlasticity="false" allowDestruction="true"
        allowContinuousDestruction="true" allowDiscreteDestruction="true"
        tensionErrorMult="1e-12" velocityErrorMult="1e-2" positionErrorMult="1e-4"
        velocityDimensionlessMult="1e+0" tensionDimensionlessMult="1e+0">
  <!--
    <Erosion cellAspectRatio="6" minHeightRatio="0.0" maxPlasticDeformation="1.004" rhoReduction="6.0"/>
  -->
  </Solver>

</Settings>
