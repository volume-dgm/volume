<?xml version="1.0" encoding="UTF-8" ?>
<Settings dimsCount="3">
  <MeshBuilder>
    <SalomeFile fileName="salome/glass" />
    <OutFile fileName = "meshes/glass" />
  </MeshBuilder>

  <Mesh fileName="meshes/glass" unfoldIterationsCount="0" minGridHeight="2e-4" moveMassCenter="false" collisionWidth="0.0001">
    <MediumParams>
      <PerSubmesh fileName="meshes/glass.params"> 
        <Submesh index="0" E="2.25e+7" G="2.87e+7" rho="2.5e-3" fixed="false" internalContactType="0">
          <!--
            <ModifyParams paramName="mju" dependencyType="linear" axisName="x" p2="1.87e+9" p1="4.68e+8" p3="-5.0" p4="5.0"/>
          -->
        </Submesh>
      </PerSubmesh>
    </MediumParams>

    <Boundaries>
      <Free interactionType="0" >
        <ExternalForce>
          <TimedImpulseFunctor value="0.0 0.0 -8.0e+6" timeBegin="1.0e-9" timeEnd="5.0e-6"/>
        </ExternalForce>
      </Free>
      <Fixed interactionType="1" />
    </Boundaries>

    <Contacts>
      <Glue interactionType = "0" maxLongitudinalStress="1.5e+6"/>
    </Contacts>
  </Mesh>

  <Snapshot>
    <Period frames="10" />
    <Data fileName="out/glass/data[<domain>]<step>.vti" writeVelocity="True" writeTension="True">
      <Box boxPoint1="-0.035 -0.035 -0.02" boxPoint2="0.035 0.035 0.0" />
      <Resolution resolution="140 140 40" />
    </Data>
    <Mesh fileName="out/glass/mesh[<domain>]<step>.vtk"/>
    <CellInfos fileName="out/glass/cell_info[<domain>]<step>.vtk"/>
  </Snapshot>

  <Schedule domainsCount="1" />

  <Task destinationTihe = "1.0e-5">
    <!--
    <IniState>
      <BoxState boxPoint1 = "-10.1 -5.0" boxPoint2 = "0.0 5.0" velocity = "1.0 0.0"/>
      <BoxState boxPoint1 = "0.0 -5.0" boxPoint2 = "10.1 5.0" velocity = "-1.0 0.0"/>
      </IniState>
    -->
  </Task>

  <Solver polynomialsOrder="1" precision="double" integrator="RK4"
          tolerance="1e-1" maxScale="1e-2" maxTimeStep="4.87e-9" hierarchyLevelsCount="1" 
          allowMovement="true" allowPlasticity="true" allowDestruction="true"
          allowDiscreteDestruction="true" 
          allowContinuousDestruction="true" 
          tensionErrorMult="1e-10" velocityErrorMult="1e-2" positionErrorMult="1e-4"
          velocityDimensionlessMult="1e+0" tensionDimensionlessMult="1e+0"/>
</Settings>
