<?xml version="1.0" encoding="UTF-8" ?>
<Settings dimsCount = "3">

  <MeshBuilder>
    <SalomeFile fileName= "salome/smooth" />
    <OutFile fileName= "meshes/smooth" />
  </MeshBuilder>
<Mesh fileName="meshes/smooth" unfoldIterationsCount="0" minGridHeight="2e-4" moveMassCenter="false" collisionWidth= "0.0"> 
    <MediumParams>
      <PerSubmesh fileName = "meshes/smooth.params"> <Submesh index="0" E="5e+9" G="1.87e+9" rho= "920" k= "2.5e+6" alpha="0.1" brittle="false" 
        internalContactType= "0" maxPlasticDeform="0.012" powderShearMult="0.1" fixed = "false"/> 
        <Submesh index="1" sSpeed="3100" pSpeed="5700" rho= "1e10" fixed = "false" internalContactType= "1"/> 
      </PerSubmesh> 
    </MediumParams>

    <Boundaries>
      <Absorb interactionType= "0">
      </Absorb>

      <Free interactionType="1" dynamicContactInteractionType="2">
      </Free>

      <Free interactionType= "2" dynamicContactInteractionType="2">
        <!--
        <ExternalForce>
          <ConstFunctor value="4e10 0.0 0.0"/>
          </ExternalForce>
        -->
        </Free>
      </Boundaries>

      <Free interactonType="3" />

    <Contacts>
      <Glue interactionType= "0" dynamicBoundaryInteractionType= "3" maxLongitudinalStress="1.2e+6"/>
      <Glue interactionType= "1" dynamicBoundaryInteractionType= "0"/>
      <Glide interactionType= "2" dynamicBoundaryInteractionType= "1"/>
    </Contacts>
  </Mesh>

  <Snapshot>
    <Period time="1e-2" />
    <Data fileName = "out/_1_smooth/data_<step>.vti"  writeVelocity="true" writeTension="true">
      <Box boxPoint1 = "-19.0 -35.0 -6.0" boxPoint2 = "70.0 35.0 7.0" />
      <Resolution resolution="178 140 26" />
      </Data>
    <Mesh fileName="out/_1_smooth/mesh_<step>.vtk" />
    <Boundaries fileName="out/_1_smooth/boundaries_<step>.vtk"/>
  </Snapshot>

  <Schedule domainsCount="1"/>

  <Task destinationTime = "4.0">
    <IniState>
      <BoxState boxPoint1 = "-20.0 -9.0 -6.0" boxPoint2 = "12.0 9.0 8.0" velocity = "4.0 0.0 -1.5"/>
      </IniState>
      <!--
    <SourceTerms>
      <ConstantAcceleration acceleration="0 0.0 -0.981"/> 
        </SourceTerms>  
      -->
  </Task>

  <Solver polynomialsOrder= "1" precision="double" integrator="RK4" updateCollisionInfoPeriod="10"
        tolerance="1e-1" maxScale="1e-2" maxTimeStep="5.45e-5" hierarchyLevelsCount="1"
        allowMovement="true" allowPlasticity="true" allowDestruction="true"
        allowContinuousDestruction="true" allowDiscreteDestruction="true"
        tensionErrorMult="1e-12" velocityErrorMult="1e-2" positionErrorMult="1e-4"
        velocityDimensionlessMult="1e+0" tensionDimensionlessMult="1e+0">
        <Erosion cellAspectRatio="6" minHeightRatio="0.0" maxPlasticDeformation="1.004" rhoReduction="6.0"/>
  </Solver>

</Settings>
